{
  "about": "Lobby boot fragment; load the game and bridge before hosting an Eden frontend room.",
  "rows": [
    {
      "id": "lobby-boot",
      "start": "frontend",
      "end": "main",
      "role": "setup",
      "on_failure": "stop",
      "steps": [
        {"run": "routes:_setting", "args": {"key": "core.use_gdbstub", "value": false}},
        {"run": "routes:host_network"},
        {"run": "routes:configure_boot"},
        {"run": "routes:load_game"},
        {"run": "routes:bridge_on"},
        {"run": "routes:to_main"}
      ]
    },
    {
      "id": "lobby-room",
      "start": "main",
      "end": "main",
      "role": "setup",
      "on_failure": "stop",
      "steps": [
        {"run": "routes:frontend_room"},
        {"run": "routes:to_main"},
        {"run": "routes:bridge_alive"}
      ]
    }
  ]
}
